<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/resetwatch_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="16dp" android:background="@drawable/resetwatch_background">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="ResetWatch" android:textSize="12sp" android:textStyle="bold" android:textColor="#14624D" />
  <TextView android:id="@+id/resetwatch_title" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="尚未读取" android:textSize="18sp" android:textStyle="bold" android:textColor="#182D29" android:maxLines="2" />
  <TextView android:id="@+id/resetwatch_state" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="状态未知" android:textSize="14sp" android:textColor="#182D29" />
  <TextView android:id="@+id/resetwatch_window" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="重置最晚时间未知" android:textSize="13sp" android:textColor="#182D29" />
  <TextView android:id="@+id/resetwatch_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textSize="11sp" android:textColor="#576D66" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/resetwatch_widget_note" android:textSize="11sp" android:textColor="#576D66" />
</LinearLayout>
